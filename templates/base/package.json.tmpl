  "devDependencies": {
    "@stavkamil/blueprint": "from-blueprint",
    "@types/node": "from-blueprint",
    "@vitest/coverage-v8": "from-blueprint",
    "eslint": "from-blueprint",
    "lefthook": "from-blueprint",
    "prettier": "from-blueprint",
    "typescript": "from-blueprint",
    "vitest": "from-blueprint"
  }
}
