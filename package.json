{
  "name": "@stavkamil/blueprint",
  "version": "1.1.0",
  "description": "Sets up an agent-first SDLC and CI/CD environment for new TypeScript projects.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stavkamil/blueprint.git"
  },
  "homepage": "https://github.com/stavkamil/blueprint#readme",
  "bugs": {
    "url": "https://github.com/stavkamil/blueprint/issues"
  },
  "type": "module",
  "bin": {
    "blueprint": "dist/index.js"
  },
  "exports": {
    "./eslint": "./presets/eslint/index.js",
    "./prettier": "./presets/prettier/index.js",
    "./tsconfig/*": "./tsconfig/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "presets",
    "standards",
    "templates",
    "tsconfig"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "node src/index.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && vitest run --config vitest.e2e.config.ts",
    "build": "tsc -p tsconfig.build.json",
    "smoke": "pnpm build && node scripts/smoke.ts",
    "prepare": "lefthook install",
    "lint:workflows": "actionlint && zizmor --offline .github/"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "lefthook": "^2.2.2",
    "next": "^16.4.2",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-barrel-files": "^3.0.1",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-jsdoc": "^65.3.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "typescript-eslint": "^8.71.2"
  },
  "prettier": "@stavkamil/blueprint/prettier",
  "peerDependencies": {
    "eslint": "^10.0.0",
    "lefthook": "^2.0.0",
    "prettier": "^3.0.0",
    "typescript": ">=6.0.0 <6.1.0",
    "eslint-config-next": ">=16.0.0"
  },
  "peerDependenciesMeta": {
    "eslint-config-next": {
      "optional": true
    }
  }
}
